datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// ------------------------------------------------------
// ENUMS (Tipos predefinidos)
// ------------------------------------------------------
enum Role {
  USER
  PRO
  ADMIN
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum EntityType {
  USER
  THREAD
  MESSAGE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}
enum NotificationType {
  EVENT         // Alertas de eventos del calendario
  VACCINE       // Recordatorio de próxima vacuna (scheduledFor)
  MEDICINE      // Recordatorio de toma de medicación (intervalHours)
  COMMUNITY     // Respuestas a hilos/mensajes del foro
  SYSTEM        // Avisos generales de la app
}

enum TagCondition {
  HEADACHE
  FEVER
  COUGH
  SORE_THROAT
  RUNNY_NOSE
  NASAL_CONGESTION
  SNEEZING
  STOMACHACHE
  CRAMPS
  NAUSEA
  VOMITING
  DIARRHEA
  CONSTIPATION
  DIZZINESS
  FATIGUE
  EARACHE
  TOOTHACHE
  RASH
  ITCHING
  WATERY_EYES
  RED_EYES
  LOSS_OF_APPETITE
  MUSCLE_PAIN
  JOINT_PAIN
  CHILLS
  SHORTNESS_OF_BREATH
  WHEEZING
  SWOLLEN_GLANDS
  TROUBLE_SLEEPING
  IRRITABILITY

}

enum Sex {
  MALE
  FEMALE
}

enum EventType {
  MEDICINE
  VACCINE
  MEDICAL_APPOINTMENT
  GENERAL
}

// ------------------------------------------------------
// GESTIÓN DE USUARIOS Y AUTENTICACIÓN
// ------------------------------------------------------
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String?   //si se crea cuenta con google, no se necesitará contraseña. Por eso password es opcional
  googleId      String?   @unique 
  name          String
  avatarUrl     String?   // URL de Cloudinary/AWS S3
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  // Relaciones
  children      Child[]
  threads       Thread[]  // Relación con el foro (Owner)
  messages      Message[]
  messageLikes  MessageLike[]
  reportsMade   Report[]  @relation("ReporterUser")
  notifications Notification[]
  //falta un enlace con notification? Pa poder notificar al user?
}

// ------------------------------------------------------
// LIBRO DE FAMILIA Y SALUD DIGITAL
// ------------------------------------------------------
model Child {
  id            Int       @id @default(autoincrement())
  name          String
  birthDate     DateTime
  bloodGroup    String?
  allergies     String?
  sex           Sex?     // Necesario para comparar con las curvas de la OMS (distintas para niños y niñas)
  
  // Relación con el padre/madre (User)
  parentId      Int
  parent        User      @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // Relaciones de salud e hitos
  measurements  Measurement[]
  vaccines      Vaccine[]
  events        Event[]
  conditions    Condition[] // se refiere a las enfermedades o a los sintomas que nosotros llamamos conditions? --> Se refiere a los sintomas que nosotros llamamos conditions. Las enfermedades diagnosticadas se guardan en la tabla Disease
  checklists    ChecklistItem[]// deberia haber una relacion directa con disease????
  medicine      Medicine[]
  diseases      Disease[]
  //falta el calendar?? --> Eso será algo q se vea directamente. En la ruta calendar/:childID se hará una llamada para cargar los datos de ese childId, + sus eventos
  
}

model Measurement { 
  id            Int       @id @default(autoincrement())
  date          DateTime
  weight        Float?     // En kg
  height        Float?     // En cm
  

  childId       Int
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Vaccine { 
  id            Int       @id @default(autoincrement())
  name          String
  scheduledFor  DateTime?  // Fecha calculada por el sistema o manual tb se puede cambiar
  appliedAt     DateTime? //null para saber si NO se ha puesto
  
  childId       Int
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  notifications Notification[]
}

model Disease {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  diagnosticatedAge     DateTime?  //En que año te lo diagnosticaron
  endDate       DateTime?

  childId       Int
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  medicine      Medicine[]


}

model ChecklistItem { // Checklist inicial de hitos
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?

  childId       Int
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Medicine {
  id               Int       @id @default(autoincrement())
  name             String    // Nombre comercial (ej. "Apiretal")
  dosage           String    // Cantidad exacta (ej. "2.5 ml", "1 supositorio")
  intervalHours    Int?      // Frecuencia en horas (ej. 8 para "cada 8 horas")
  startDate        DateTime  @default(now()) // Inicio del tratamiento
  endDate          DateTime? // Fin del tratamiento (nulo si es crónico o "a demanda")
  instructions     String?   @db.Text // Instrucciones extra (ej. "Junto con comida")

  // Relación obligatoria: Quién toma la medicación
  childId          Int
  child            Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  // Relación opcional: Qué condition (síntomas) motivó la toma. Puedes no registrar una condition, pero si llevar un registro de que se ha tomado
  conditionId      Int?
  condition        Condition? @relation(fields: [conditionId], references: [id])

  // Relación opcional: Qué enfermedad diagnosticada motivó la toma. PUeedes no registrar Disease pero si que te has tomado algo.
  diseaseId        Int?
  disease          Disease?   @relation(fields: [diseaseId], references: [id])

  notifications Notification[]
}

// ------------------------------------------------------
// CALENDARIO Y SEGUIMIENTO DIARIO
// ------------------------------------------------------
model Event { 
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  date          DateTime
  notification   Boolean   @default(false)
  type          EventType @default(GENERAL)


  childId       Int
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  notifications Notification[]

}

model Condition { 
  id            Int       @id @default(autoincrement())
  tag           TagCondition[]    // Ej: "Fiebre", "Vómitos" 
  desciption    String?
  timestamp     DateTime  @default(now())
  notes         String?
  
  childId       Int
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  medicine      Medicine[]
}

model Notification {
  id          Int                @id @default(autoincrement())
  type        NotificationType   @default(EVENT)
  title       String             // Ej: "Recordatorio: Vacuna de Mateo"
  body        String             // Ej: "Mañana toca la vacuna de los 4 meses."
  scheduledAt DateTime           // Momento exacto en que debe emitirse
  sentAt      DateTime?          // Cuándo se envió realmente
  status      NotificationStatus @default(PENDING)
  data        Json?              // Metadatos para redirigir en la app móvil al pulsar la notificación
  // 1. Destinatario (Quién recibe la alerta)
  userId      Int
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 2. Relaciones opcionales con los módulos de tu app
  eventId     Int?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vaccineId   Int?
  vaccine     Vaccine?           @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  medicineId  Int?
  medicine    Medicine?          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@index([scheduledAt, status])
}



// ------------------------------------------------------
// COMUNIDAD Y FORO (Con sistema de reportes)
// ------------------------------------------------------
model Thread { 
  id            Int       @id @default(autoincrement())
  title         String
  content       String    @db.Text
  createdAt     DateTime  @default(now())
  isHidden      Boolean   @default(false) // Pa moderación 

  ownerId       Int
  owner         User      @relation(fields: [ownerId], references: [id])

  messages      Message[]
  tags          Tag[]     

  @@index([createdAt])
  @@index([ownerId])
}

model Message { 
  id            Int       @id @default(autoincrement())
  content       String    @db.Text
  likesCount    Int       @default(0) // UT-21: Sistema de votos MVP
  createdAt     DateTime  @default(now())
  isHidden      Boolean   @default(false) // Para moderación

  authorId      Int
  author        User      @relation(fields: [authorId], references: [id])

  threadId      Int       //Columna física guardada en la BD
  thread        Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade) //Esto no se guarda en la BD, 
                              //solamente es para que el prisma busque el Int de authorId en la tabla User para relacionarlo.

  // Respuestas anidadas
  parentId      Int?
  parent        Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull) //Pa mostrar por front: contestando a... Mirar arriba de un hilo type shit
  replies       Message[] @relation("MessageReplies") //Buscar aquellos mensajes cuyo parentId sea este mensaje. Mirar abajo en un hilo type shit

  likes         MessageLike[]

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

model MessageLike { // Un like por usuario y mensaje. Message.likesCount es el contador desnormalizado
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId     Int
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@id([userId, messageId])
  @@index([messageId])
}



model Tag { 
  id            Int       @id @default(autoincrement())
  name          String    @unique
  
  threads       Thread[]
}

// ------------------------------------------------------
// ADMINISTRACIÓN Y MODERACIÓN
// ------------------------------------------------------
model Report { // Soporta las 3 nuevas UTs de Moderación
  id            Int       @id @default(autoincrement())
  reason        String
  status        ReportStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  
  // Polimorfismo básico para saber qué se está reportando y no crear 3 tblas diferentes
  targetType    EntityType
  targetId      Int       // Guarda el ID del User, Thread o Message reportado
  
  reporterId    Int
  reporter      User      @relation("ReporterUser", fields: [reporterId], references: [id])
}