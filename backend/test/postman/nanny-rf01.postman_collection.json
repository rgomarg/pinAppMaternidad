          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventLeoIdCopia', pm.collectionVariables.get('eventLeoId'));",
                  "if (!pm.collectionVariables.get('eventLeoId')) { pm.execution.skipRequest(); }"
