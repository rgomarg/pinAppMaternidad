{
  "info": {
    "name": "Nanny - RF-01 Registro de evento médico con recordatorio",
    "description": "Pruebas de aceptación del registro de eventos médicos con recordatorio (RF-01). Requiere el backend en marcha y la base de datos cargada con el seed (npx prisma db seed).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación (IDs dinámicos)",
      "description": "Obtiene los IDs reales de los usuarios y menores del seed. Los IDs cambian cada vez que se ejecuta el seed, por eso no se escriben a mano.",
      "item": [
        {
          "name": "SETUP-1 Buscar a la tutora (Laura)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve 200\", () => pm.response.to.have.status(200));",
                  "const laura = pm.response.json().find(u => u.email === 'laura.pro@example.com');",
                  "pm.test(\"Existe la tutora del seed\", () => pm.expect(laura, 'Laura').to.exist);",
                  "pm.collectionVariables.set('lauraId', laura.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "SETUP-2 Menores de Laura (Leo e Inés)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/{{lauraId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "{{lauraId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve 200\", () => pm.response.to.have.status(200));",
                  "const kids = pm.response.json().children;",
                  "const leo = kids.find(c => c.name === 'Leo');",
                  "const ines = kids.find(c => c.name === 'Inés');",
                  "pm.test(\"Laura tiene a Leo e Inés\", () => {",
                  "    pm.expect(leo).to.exist;",
                  "    pm.expect(ines).to.exist;",
                  "});",
                  "pm.collectionVariables.set('leoId', leo.id);",
                  "pm.collectionVariables.set('inesId', ines.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "RF-01 Registro de evento médico con recordatorio",
      "item": [
        {
          "name": "PA-01 Crear evento válido con recordatorio (Leo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "event"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"  Cita pediatra Leo  \",\n  \"description\": \"Revisión de los 18 meses\",\n  \"date\": \"{{testDate}}T09:30:00.000Z\",\n  \"notification\": true,\n  \"type\": \"MEDICAL_APPOINTMENT\",\n  \"childId\": {{leoId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve 201 Created\", () => pm.response.to.have.status(201));",
                  "const ev = pm.response.json();",
                  "pm.test(\"Se asocia al menor correcto (Leo)\", () => pm.expect(ev.child.id).to.eql(Number(pm.collectionVariables.get('leoId'))));",
                  "pm.test(\"Guarda el recordatorio activado\", () => pm.expect(ev.notification).to.eql(true));",
                  "pm.test(\"Guarda el tipo de evento\", () => pm.expect(ev.type).to.eql('MEDICAL_APPOINTMENT'));",
                  "pm.test(\"Elimina espacios sobrantes del título\", () => pm.expect(ev.title).to.eql('Cita pediatra Leo'));",
                  "pm.test(\"Guarda la fecha exacta\", () => pm.expect(ev.date).to.eql(pm.collectionVariables.get('testDate') + 'T09:30:00.000Z'));",
                  "pm.collectionVariables.set('eventLeoId', ev.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PA-01b Crear evento con valores por defecto (Inés)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "event"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Vacuna Inés\",\n  \"date\": \"{{testDate}}T08:00:00.000Z\",\n  \"childId\": {{inesId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve 201 Created\", () => pm.response.to.have.status(201));",
                  "const ev = pm.response.json();",
                  "pm.test(\"Se asocia al menor correcto (Inés)\", () => pm.expect(ev.child.id).to.eql(Number(pm.collectionVariables.get('inesId'))));",
                  "pm.test(\"Por defecto: sin recordatorio\", () => pm.expect(ev.notification).to.eql(false));",
                  "pm.test(\"Por defecto: tipo GENERAL\", () => pm.expect(ev.type).to.eql('GENERAL'));",
                  "pm.test(\"Sin descripción se guarda como null\", () => pm.expect(ev.description).to.eql(null));",
                  "pm.collectionVariables.set('eventInesId', ev.id);"
                ]
              }
            }
          ]
        },
