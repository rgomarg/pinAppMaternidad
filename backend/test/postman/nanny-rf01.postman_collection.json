              "mode": "raw",
              "raw": "{\n  \"title\": \"Cita médica: Cita pediatra Leo\",\n  \"body\": \"Evento para Leo\",\n  \"scheduledAt\": \"{{testDate}}T09:00:00.000Z\",\n  \"userId\": {{lauraId}},\n  \"type\": \"EVENT\",\n  \"eventId\": {{eventLeoId}},\n  \"data\": { \"screen\": \"Calendario\", \"id\": {{eventLeoId}}, \"type\": \"EVENT\" }\n}",
